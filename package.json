{
  "name": "ifood-order-manager-box-qr-code",
  "version": "1.0.0",
  "description": "Windows service that captures order data from Gestor de Pedidos Desktop and enriches thermal receipts with QR codes",
  "type": "module",
  "main": "dist/service/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/service/main.js",
    "dev": "tsx src/service/main.ts",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "enable:gestor": "powershell -ExecutionPolicy Bypass -File scripts/enable-gestor-debug.ps1",
    "install:virtual-printer": "powershell -ExecutionPolicy Bypass -File scripts/install-virtual-printer.ps1",
    "configure:portprompt": "powershell -ExecutionPolicy Bypass -File scripts/configure-portprompt-mode.ps1",
    "test:service": "node scripts/test-service.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
